# ===================================================================
#                Clinicon - Unified Environment Variables
# ===================================================================
# تم تجميع كافة متغيرات البيئة الخاصة بالمشروع (Database, Backend, AI Agent, RAG, Frontend)
# في هذا الملف الموحد لسهولة ضبطها عند النشر السحابي (Supabase / Vercel / Render).
# ===================================================================

# -------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase / PostgreSQL / SQLite Local)
# -------------------------------------------------------------------
# بيئة العمل المحلية تستخدم SQLite تلقائياً إذا لم تتوفر PostgreSQL
# في الإنتاج السحابي (Supabase): استبدل الرابط برابط Supabase المباشر
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres
# -------------------------------------------------------------------
# 2. BACKEND API CONFIGURATION (Flask / FastAPI / Express Backend)
# -------------------------------------------------------------------
# المفتاح السري لتشفير الـ JWT Tokens
SECRET_KEY=your-secret-key-here
# بورت تشغيل الباك إند
PORT=5000
BACKEND_BASE_URL=http://localhost:5000/api
# في الإنتاج: BACKEND_BASE_URL=https://clinicon-backend.onrender.com/api

# -------------------------------------------------------------------
# 3. AI AGENT CONFIGURATION (Gemini LLM & Ollama)
# -------------------------------------------------------------------
# تفعيل Gemini بدلاً من الموديل المحلي (true / false)
USE_GEMINI=true

# اسم الموديل المعتمد من Gemini
GEMINI_MODEL=gemini-3.6-flash

# مفتاح Google Gemini API Key الخاص بك
GEMINI_API_KEY=your-gemini-api-key-here

# إعدادات Ollama الموديل المحلي (عند استخدام USE_GEMINI=false)
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434

# درجة الإبداع والحرارة للموديل
TEMPERATURE=0.1

# -------------------------------------------------------------------
# 4. RAG SERVER CONFIGURATION (Vector Search)
# -------------------------------------------------------------------
RAG_BASE_URL=http://localhost:8100
# في الإنتاج: RAG_BASE_URL=https://clinicon-rag.onrender.com

# -------------------------------------------------------------------
# 5. TELEGRAM NOTIFICATION BOT CONFIGURATION
# -------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=8819884732:AAEbkEh8alGAtMN4z2UGOxA2-Dc7DZgM6bI
TELEGRAM_CHAT_ID=7071102303

# -------------------------------------------------------------------
# 6. FRONTEND (Next.js) ENVIRONMENT VARIABLES (Vercel)
# -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_AGENT_URL=http://localhost:8200
# في الإنتاج على Vercel:
# NEXT_PUBLIC_API_URL=https://clinicon-backend.onrender.com/api
# NEXT_PUBLIC_AGENT_URL=https://clinicon-agent.onrender.com
